{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      },
      "$projectId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "rfis": {
      "$rfiId": {
        "comments": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "rfi_threads": {
      "$issueId": {
        "comments": {
          ".read": "auth != null",
          "$commentId": {
            ".write": "auth != null"
          }
        }
      }
    },
    "telemetry": {
      "$projectId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
