rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function isManager() {
      return hasRole('PROJECT_MANAGER');
    }
    
    function isSupervisor() {
      return hasRole('SITE_SUPERVISOR');
    }
    
    function isEngineer() {
      return hasRole('ENGINEER');
    }
    
    function isStaff() {
      return isManager() || isSupervisor() || isEngineer();
    }
    
    // User Profiles: Users can read staff profiles; can only update their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == userId || isManager());
      allow delete: if isManager();
    }
    
    // Projects Collection: All authenticated staff can read assigned projects
    match /projects/{projectId} {
      allow read: if isStaff();
      allow create, update: if isManager() || isSupervisor();
      allow delete: if isManager();
      
      // Sub-collection: Construction Activities & Progress
      match /activities/{activityId} {
        allow read: if isStaff();
        allow create, update: if isStaff();
        allow delete: if isManager();
        
        match /history/{historyId} {
          allow read: if isStaff();
          allow create: if isStaff();
          allow update, delete: if isManager();
        }
      }
      
      // Sub-collection: Site Quality Inspections
      match /inspections/{inspectionId} {
        allow read: if isStaff();
        allow create, update: if isEngineer() || isSupervisor() || isManager();
        allow delete: if isManager();
        
        match /records/{recordId} {
          allow read: if isStaff();
          allow create: if isStaff();
          allow update, delete: if isManager();
        }
      }
      
      // Sub-collection: Drawings & CAD Documents
      match /documents/{documentId} {
        allow read: if isStaff();
        allow create, update: if isEngineer() || isManager();
        allow delete: if isManager();
        
        match /revisions/{revisionId} {
          allow read: if isStaff();
          allow create: if isEngineer() || isManager();
          allow update, delete: if isManager();
        }
      }
      
      // Sub-collection: Technical Issues / RFIs
      match /issues/{issueId} {
        allow read: if isStaff();
        allow create, update: if isStaff();
        allow delete: if isManager();
        
        match /comments/{commentId} {
          allow read: if isStaff();
          allow create: if isStaff();
          allow update, delete: if request.auth.uid == resource.data.authorId || isManager();
        }
      }
      
      // Sub-collection: Daily Site Reports (DSR)
      match /daily_reports/{reportId} {
        allow read: if isStaff();
        allow create, update: if isEngineer() || isSupervisor() || isManager();
        allow delete: if isManager();
      }
    }
  }
}
