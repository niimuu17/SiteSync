rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isEngineer() {
      return isAuth() && (getUserRole() == 'ENGINEER' || getUserRole() == 'PROJECT_MANAGER');
    }
    function isManager() {
      return isAuth() && getUserRole() == 'PROJECT_MANAGER';
    }

    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;
    }

    match /projects/{projectId} {
      allow read: if isAuth();
      allow write: if isManager();

      match /activities/{activityId} {
        allow read: if isAuth();
        allow write: if isEngineer();
      }
      match /inspections/{inspectionId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }
      match /documents/{docId} {
        allow read: if isAuth();
        allow write: if isEngineer();
      }
      match /daily_reports/{reportId} {
        allow read: if isAuth();
        allow create, update: if isEngineer();
        allow delete: if isManager();
      }
    }

    // Direct root collections fallback for offline and prototype sync
    match /activities/{activityId} {
      allow read: if isAuth();
      allow write: if isEngineer();
    }
    match /inspections/{inspectionId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }
    match /documents/{docId} {
      allow read: if isAuth();
      allow write: if isEngineer();
    }
    match /issues/{issueId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }
    match /daily_reports/{reportId} {
      allow read: if isAuth();
      allow create, update: if isEngineer();
      allow delete: if isManager();
    }
  }
}
