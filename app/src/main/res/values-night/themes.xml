<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Strict Dark Industrial Telemetry Theme (Night) -->
    <style name="Theme.SiteSync" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/bg_canvas</item>
        <item name="colorSurface">@color/bg_surface_elevated</item>
        <item name="android:colorBackground">@color/bg_canvas</item>

        <item name="colorPrimary">@color/accent_safety_yellow</item>
        <item name="colorPrimaryVariant">@color/bg_surface_elevated</item>
        <item name="colorOnPrimary">#111317</item>

        <item name="colorSecondary">@color/accent_safety_yellow</item>
        <item name="colorSecondaryVariant">@color/accent_hazard_orange</item>
        <item name="colorOnSecondary">#111317</item>

        <item name="android:statusBarColor">@color/bg_canvas</item>
        <item name="android:navigationBarColor">@color/bg_canvas</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <item name="cardBackgroundColor">@color/bg_surface_elevated</item>
        <item name="strokeColor">@color/stroke_card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="editTextColor">@color/text_primary</item>
    </style>
</resources>
