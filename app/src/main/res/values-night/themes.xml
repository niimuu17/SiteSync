<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- SiteSync Oxide Blue & Warm Ash Architectural Theme (Night Fallback) -->
    <style name="Theme.SiteSync" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Canvas & Surfaces (Warm Ash Base) -->
        <item name="android:windowBackground">@color/warm_ash_base</item>
        <item name="colorSurface">@color/warm_ash_surface</item>
        <item name="android:colorBackground">@color/warm_ash_base</item>

        <!-- Brand Primary (Oxide Blue) -->
        <item name="colorPrimary">@color/oxide_blue_primary</item>
        <item name="colorPrimaryVariant">@color/oxide_blue_dark</item>
        <item name="colorOnPrimary">@color/text_on_oxide_white</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/oxide_blue_primary</item>
        <item name="colorSecondaryVariant">@color/oxide_blue_light</item>
        <item name="colorOnSecondary">@color/text_on_oxide_white</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/warm_ash_base</item>
        <item name="android:navigationBarColor">@color/warm_ash_base</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Card & Component Styling Defaults -->
        <item name="cardBackgroundColor">@color/warm_ash_surface</item>
        <item name="strokeColor">@color/stroke_oxide_blue</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">20dp</item>

        <!-- Field Typography & Controls -->
        <item name="android:textColorPrimary">@color/text_oxide_primary</item>
        <item name="android:textColorSecondary">@color/text_oxide_secondary</item>
        <item name="android:textColorTertiary">@color/text_oxide_muted</item>
        <item name="android:textColorHint">@color/text_oxide_muted</item>
        <item name="editTextColor">@color/text_oxide_primary</item>
    </style>

    <style name="IndustrialCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/warm_ash_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke_oxide_blue</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="IndustrialButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/oxide_blue_primary</item>
        <item name="android:textColor">@color/text_on_oxide_white</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="IndustrialButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/stroke_oxide_blue</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/text_oxide_primary</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
