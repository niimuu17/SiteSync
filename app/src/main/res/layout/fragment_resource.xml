<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_ash_base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="100dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SITE WORKFORCE &amp; EQUIPMENT"
            android:textColor="@color/text_oxide_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <!-- Total Headcount Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_oxide_banner_card"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42 Deployed Field Workers"
                    android:textColor="@color/text_on_oxide_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="SHIFT 1"
                    android:textColor="@color/oxide_blue_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_white_pill_badge"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zero safety incidents reported today • All personnel checked-in"
                android:textColor="@color/warm_ash_surface"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Trades Breakdown Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_outlined"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trades Roster"
                android:textColor="@color/text_oxide_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Steel Fixers: 16 Workers (Level 3 Column Rebar)"
                android:textColor="@color/text_oxide_primary"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Formwork Carpenters: 14 Workers (Perimeter Slabs)"
                android:textColor="@color/text_oxide_primary"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Electricians: 8 Workers (Conduit Pulling)"
                android:textColor="@color/text_oxide_primary"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Tower Crane Riggers: 4 Workers (Crane #2 Operations)"
                android:textColor="@color/text_oxide_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- BUILDING PLAN & CAD BLUEPRINT CARD (From Dribbble Center Screen) -->
        <!-- ============================================================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ARCHITECTURAL CAD &amp; FLOOR PLAN"
            android:textColor="@color/text_oxide_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_outlined"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- Card Header: Level & Date Pills -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Building 2 • Level 2"
                    android:textColor="@color/text_oxide_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_inactive"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12 Feb 2026"
                    android:textColor="@color/text_oxide_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_inactive"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Furnishing Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_oxide_banner_card"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Furnishing"
                        android:textColor="@color/text_on_oxide_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="53 % ↗"
                        android:textColor="@color/brand_amber"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Schedule: 5 - 23 Feb, 2026"
                    android:textColor="@color/warm_ash_surface"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp" />

                <!-- Hatched Progress Indicator -->
                <com.example.sitesync.ui.custom.HatchedProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    app:barProgress="53"
                    app:barStripeColor="@color/brand_amber"
                    app:barTrackColor="@color/oxide_blue_dark"
                    app:delayMarkerText="" />
            </LinearLayout>

            <!-- Type 2-32 Breakdown Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Type 2-32 • 342 M²"
                    android:textColor="@color/text_oxide_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Finishing: 11/4/2026 ↗"
                    android:textColor="@color/text_oxide_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
