<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_outlined"
    android:padding="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="24dp">

    <!-- Header: Status & Icon -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivTelemetrySyncIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_cloud_done"
                app:tint="@color/status_green"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFLINE CACHE &amp; CLOUD SYNC"
                android:textColor="@color/text_oxide_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRoomDbStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="HEALTHY"
            android:textColor="#065F46"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_optimal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All tasks, requisitions, and safety tickets persist to encrypted SQLite WAL storage before background dispatch."
        android:textColor="@color/text_oxide_secondary"
        android:textSize="11sp"
        android:layout_marginBottom="14dp" />

    <!-- Two-column telemetry stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <!-- Stat 1: Pending Queue -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_rounded_input"
            android:padding="12dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING QUEUE"
                android:textColor="@color/text_oxide_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvPendingSyncCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Operations"
                android:textColor="@color/text_oxide_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Stat 2: Connection Type -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_rounded_input"
            android:padding="12dp"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NETWORK INTERFACE"
                android:textColor="@color/text_oxide_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvNetworkInterface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi / Cellular"
                android:textColor="@color/text_oxide_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Manual Sync Flush Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnManualSyncFlush"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_pill_primary"
        app:backgroundTint="@null"
        android:text="⟳  MANUAL SYNC FLUSH"
        android:textColor="@color/text_on_oxide_white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

</LinearLayout>
