<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_forest"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_squircle_brand"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/forest_dark"
                    android:padding="10dp"
                    android:contentDescription="Evidence Storage" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Geotagged Site Evidence"
                        android:textColor="@color/text_on_dark_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEvidenceCloudStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Archived to Firebase Cloud Storage"
                        android:textColor="@color/peach_accent"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCloseEvidenceModal"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_on_dark_muted" />
        </RelativeLayout>

        <!-- Preview / Latest Photo Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_card_inset_forest"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivEvidenceMainPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Latest evidence preview" />

            <LinearLayout
                android:id="@+id/layoutEvidencePlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/forest_muted"
                    android:contentDescription="Placeholder camera" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Evidence Photos Captured Yet"
                    android:textColor="@color/text_on_dark_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap below to capture tamper-proof geotagged evidence."
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- GPS Stamp Badge Overlay -->
            <TextView
                android:id="@+id/tvEvidenceGpsBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:background="@drawable/bg_pill_forest"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="GPS: 23.8103° N, 90.4125° E • Stamped"
                android:drawableStart="@drawable/ic_location"
                android:drawablePadding="4dp"
                android:drawableTint="@color/text_on_dark_primary"
                android:gravity="center_vertical"
                android:textColor="@color/text_on_dark_primary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Action Buttons Row: Camera & Gallery -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCaptureEvidenceModal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Take Geotagged Camera Photo"
                android:textColor="@color/forest_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_camera"
                app:iconTint="@color/forest_dark"
                app:iconGravity="textStart"
                app:backgroundTint="@color/peach_accent"
                app:cornerRadius="26dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddProjectPhotoModal"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Add Project Photo from Gallery"
                android:textColor="@color/peach_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_photo_library"
                app:iconTint="@color/peach_accent"
                app:iconGravity="textStart"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/peach_accent"
                app:strokeWidth="1.5dp"
                app:cornerRadius="25dp" />
        </LinearLayout>

        <!-- Evidence Photos Dump Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ALL PROJECT EVIDENCE PHOTOS"
                android:textColor="@color/peach_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/tvDumpHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap photo to view"
                android:textColor="@color/text_on_dark_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Horizontal Evidence Dump Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEvidencePhotosDump"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:layout_marginBottom="16dp" />

        <!-- Recent Photos Counter & Status -->
        <TextView
            android:id="@+id/tvEvidenceCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recent Archival: 1 photo saved in WAL storage"
            android:textColor="@color/text_on_dark_muted"
            android:textSize="12sp"
            android:gravity="center" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
