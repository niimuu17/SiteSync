<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/forest_card_dark"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/forest_stroke"
    app:strokeWidth="1dp"
    app:rippleColor="@color/peach_alpha">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Icon + Type Badge + Timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTxTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STOCK IN"
                android:textColor="@color/badge_green_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvChallanOrRef"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CH-88219"
                android:textColor="@color/peach_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTxDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 mins ago"
                android:textColor="@color/text_on_dark_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Middle Row: Item Name & Quantity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTxItemName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BSRM 500W 16mm Rebar"
                android:textColor="@color/text_on_dark_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTxQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ 5.0 TON"
                android:textColor="@color/text_on_dark_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Row: Supplier / Site Crew & Total Cost -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTxParty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Supplier: Apex Construction"
                android:textColor="@color/text_on_dark_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTxCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$ 460,000"
                android:textColor="@color/peach_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
