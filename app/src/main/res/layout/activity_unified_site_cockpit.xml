<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_ash_base">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar / Context Header (Warm Ash Canvas) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@color/warm_ash_base">

            <!-- Minimalist Structural Brand Mark -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_squircle_amber"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_app_brand_symbol"
                    app:tint="@color/oxide_blue_primary"
                    android:contentDescription="Brand" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SiteSync"
                    android:textColor="@color/text_oxide_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserRoleClaim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ELENA ROSTOVA • ENGINEER"
                    android:textColor="@color/text_oxide_secondary"
                    android:textSize="12sp"
                    android:letterSpacing="0.04"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Solid Role Pill (Oxide Blue) -->
            <TextView
                android:id="@+id/tvActiveRoleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENGINEER"
                android:textColor="@color/text_on_oxide_white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tab_pill_active"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginEnd="10dp" />

            <!-- Three-Dot Options Menu -->
            <ImageView
                android:id="@+id/btnCockpitMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_more_horiz"
                app:tint="@color/text_oxide_primary"
                android:contentDescription="Options Menu" />
        </LinearLayout>

        <!-- Context Location Banner (Outlined Warm Ash Surface with 4-Square Icon & Trigger) -->
        <com.example.sitesync.ui.common.ContextBannerView
            android:id="@+id/contextBannerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <!-- Segmented Horizontal Pill Tab Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabPillWorkAreas"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Work Areas"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_tab_pill_active"
                    android:textColor="@color/text_on_oxide_white"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tabPillProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Progress"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_tab_pill_inactive"
                    android:textColor="@color/text_oxide_primary"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tabPillQaCad"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="QA &amp; Blueprints"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_tab_pill_inactive"
                    android:textColor="@color/text_oxide_primary"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tabPillDaily"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Daily &amp; Issues"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_tab_pill_inactive"
                    android:textColor="@color/text_oxide_primary" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ViewPager2 hosting 4 Cockpit Tab Fragments -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerCockpit"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Floating Navigation Dock at Bottom (Solid Oxide Blue Pill) -->
    <com.example.sitesync.ui.common.NavigationDockView
        android:id="@+id/navigationDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
