<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_canvas_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/progressNestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp">

            <!-- Section Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SITE PROGRESS &amp; AUDIT"
                        android:textColor="@color/forest_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvProgressProjectHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Metro Central Tower"
                        android:textColor="@color/forest_dark"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Live Status Pill Badge -->
                <TextView
                    android:id="@+id/tvLiveStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Telemetry"
                    android:textColor="@color/text_on_dark_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_forest"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>

            <!-- ============================================================= -->
            <!-- SECTION 1: OVERALL PROGRESS & BANGLADESH CIVIL TRADE INDICES  -->
            <!-- ============================================================= -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/forest_card_dark"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/forest_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header Row: Title & "Add/Edit Project Plan" Action Button -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OVERALL PROGRESS &amp; S-CURVE"
                            android:textColor="@color/peach_accent"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true" />

                        <!-- Add Project Plan Button Pill -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddProjectPlan"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="Project Plan"
                            android:textColor="@color/forest_dark"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_straighten"
                            app:iconTint="@color/forest_dark"
                            app:iconSize="14dp"
                            app:iconGravity="textStart"
                            app:backgroundTint="@color/peach_accent"
                            app:cornerRadius="17dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="10dp" />
                    </RelativeLayout>

                    <!-- Large KPI Stat Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvProgressPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="68%"
                            android:textColor="@color/peach_accent"
                            android:textSize="44sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:id="@+id/tvProgressTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+2.23% this week"
                                android:textColor="@color/badge_green_text"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_badge_green"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp" />

                            <TextView
                                android:id="@+id/tvScheduleStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="On Schedule"
                                android:textColor="@color/text_on_dark_secondary"
                                android:textSize="11sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Horizontal Progress Bar -->
                    <com.example.sitesync.ui.custom.HatchedProgressBar
                        android:id="@+id/hatchedProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:layout_marginBottom="16dp"
                        app:hpbProgress="68"
                        app:hpbTargetMilestone="85"
                        app:hpbProgressColor="@color/peach_accent"
                        app:hpbTrackColor="@color/forest_card_inset" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/forest_stroke_subtle"
                        android:layout_marginBottom="14dp" />

                    <!-- BANGLADESH CIVIL TRADE BREAKDOWN GRID (6 Trades) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BANGLADESH TRADE COMPLETION INDICES"
                        android:textColor="@color/peach_accent"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="10dp" />

                    <!-- Row 1: Civil, Thai Glass, Tiles -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <!-- Civil & Structure -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Civil &amp; Structure"
                                android:textColor="@color/text_on_dark_muted"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTradeCivilPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="92%"
                                android:textColor="@color/text_on_dark_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Thai Glass & Windows -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thai Glass"
                                android:textColor="@color/text_on_dark_muted"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTradeThaiGlassPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="45%"
                                android:textColor="@color/peach_accent"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Tiles & Flooring -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tiles &amp; Flooring"
                                android:textColor="@color/text_on_dark_muted"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTradeTilesPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30%"
                                android:textColor="@color/peach_accent"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 2: Electrical, Plumbing, Plaster/Interior -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <!-- Electrical & Wiring -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Electrical"
                                android:textColor="@color/text_on_dark_muted"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTradeElectricPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="65%"
                                android:textColor="@color/text_on_dark_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Plumbing & Sanitary -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Plumbing &amp; Sanitary"
                                android:textColor="@color/text_on_dark_muted"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTradePlumbingPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="58%"
                                android:textColor="@color/text_on_dark_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Plaster & Interior -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Plaster &amp; Interior"
                                android:textColor="@color/text_on_dark_muted"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTradePlasterPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="50%"
                                android:textColor="@color/text_on_dark_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Footer: Building Plan Brief -->
                    <TextView
                        android:id="@+id/tvProgressPlanSummaryBrief"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Plan: 2-Room Building • 10ft Wall Height • 6 Windows • 4 Doors"
                        android:textColor="@color/text_on_dark_muted"
                        android:textSize="11sp"
                        android:drawableStart="@drawable/ic_straighten"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/peach_accent"
                        android:gravity="center_vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================================= -->
            <!-- SECTION 2: SLEEK ACTION MINI CARDS (Replaces Bulky Forms)     -->
            <!-- ============================================================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SITE OPERATIONS &amp; FIELD TOOLS"
                android:textColor="@color/forest_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp" />

            <!-- Mini Card 1: Log Daily Progress Entry (AI LLM Evaluator) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMiniLogProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/forest_card_dark"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/forest_stroke"
                app:strokeWidth="1dp"
                app:rippleColor="@color/peach_alpha">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_squircle_brand"
                        android:backgroundTint="@color/peach_accent">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/forest_dark"
                            android:contentDescription="Log entry icon" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Log Daily Progress Entry"
                            android:textColor="@color/text_on_dark_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Describe today's work • AI estimates completed %"
                            android:textColor="@color/text_on_dark_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_diagonal"
                        app:tint="@color/peach_accent"
                        android:contentDescription="Open log modal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mini Card 2: Geotagged Site Evidence Camera -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMiniEvidenceCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/forest_card_dark"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/forest_stroke"
                app:strokeWidth="1dp"
                app:rippleColor="@color/peach_alpha">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_squircle_brand"
                        android:backgroundTint="@color/forest_card_inset">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/peach_accent"
                            android:contentDescription="Camera icon" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Geotagged Site Evidence"
                            android:textColor="@color/text_on_dark_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tamper-proof photos • Archived to Firebase"
                            android:textColor="@color/text_on_dark_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_diagonal"
                        app:tint="@color/peach_accent"
                        android:contentDescription="Open camera modal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mini Card 3: Audit Trail & Report Export -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMiniAuditExport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/forest_card_dark"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/forest_stroke"
                app:strokeWidth="1dp"
                app:rippleColor="@color/peach_alpha">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_squircle_brand"
                        android:backgroundTint="@color/forest_card_inset">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bar_chart"
                            app:tint="@color/peach_accent"
                            android:contentDescription="Report icon" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Audit Trail &amp; Report Export"
                            android:textColor="@color/text_on_dark_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Generate certified PDF reports &amp; Excel/CSV logs"
                            android:textColor="@color/text_on_dark_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_diagonal"
                        app:tint="@color/peach_accent"
                        android:contentDescription="Open export modal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
