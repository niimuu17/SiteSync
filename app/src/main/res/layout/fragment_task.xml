<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_ash_base">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Filter Chips Bar -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="14dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupTaskFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterAll"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="All"
                        android:textColor="@color/selector_tab_pill_text"
                        app:chipBackgroundColor="@color/selector_tab_pill_bg"
                        app:chipStrokeColor="@color/stroke_oxide_blue"
                        app:chipStrokeWidth="1.5dp"
                        app:chipCornerRadius="19dp"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterTodo"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="To-Do"
                        android:textColor="@color/selector_tab_pill_text"
                        app:chipBackgroundColor="@color/selector_tab_pill_bg"
                        app:chipStrokeColor="@color/stroke_oxide_blue"
                        app:chipStrokeWidth="1.5dp"
                        app:chipCornerRadius="19dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterInProgress"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="In-Progress"
                        android:textColor="@color/selector_tab_pill_text"
                        app:chipBackgroundColor="@color/selector_tab_pill_bg"
                        app:chipStrokeColor="@color/stroke_oxide_blue"
                        app:chipStrokeWidth="1.5dp"
                        app:chipCornerRadius="19dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterReview"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Under Review"
                        android:textColor="@color/selector_tab_pill_text"
                        app:chipBackgroundColor="@color/selector_tab_pill_bg"
                        app:chipStrokeColor="@color/stroke_oxide_blue"
                        app:chipStrokeWidth="1.5dp"
                        app:chipCornerRadius="19dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterCompleted"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Completed"
                        android:textColor="@color/selector_tab_pill_text"
                        app:chipBackgroundColor="@color/selector_tab_pill_bg"
                        app:chipStrokeColor="@color/stroke_oxide_blue"
                        app:chipStrokeWidth="1.5dp"
                        app:chipCornerRadius="19dp" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Milestones Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_outlined"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="🎯 UPCOMING MILESTONES"
                        android:textColor="@color/text_oxide_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/tvMilestonesBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="3 ACTIVE"
                        android:textColor="@color/text_on_oxide_white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tab_pill_active"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </RelativeLayout>

                <!-- Milestone Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pour Core Wall B3"
                        android:textColor="@color/text_oxide_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Due in 2 days"
                        android:textColor="#991B1B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_urgent"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gauge_track_ash"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <!-- Milestone Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="HVAC Rough-in Inspection"
                        android:textColor="@color/text_oxide_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Due in 5 days"
                        android:textColor="#92400E"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_medium"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gauge_track_ash"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <!-- Milestone Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rebar Tensile Sampling"
                        android:textColor="@color/text_oxide_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Due in 8 days"
                        android:textColor="#065F46"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_optimal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Active Tasks Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvActiveTasksHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="ACTIVE TASKS"
                    android:textColor="@color/text_oxide_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvTaskCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/tvActiveTasksHeader"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:text="(4)"
                    android:textColor="@color/text_oxide_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Task List RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Empty State Container -->
            <LinearLayout
                android:id="@+id/layoutEmptyTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/text_oxide_muted"
                    android:contentDescription="All Done" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No tasks in this category"
                    android:textColor="@color/text_oxide_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Button: Create Task -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreateTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="90dp"
        android:src="@drawable/ic_add"
        app:tint="@color/text_on_oxide_white"
        app:backgroundTint="@color/oxide_blue_primary"
        app:elevation="6dp"
        android:contentDescription="Create New Task" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>