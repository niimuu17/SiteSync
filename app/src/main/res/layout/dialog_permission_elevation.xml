<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_outlined"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_warning_hazard"
            app:tint="@color/oxide_blue_primary"
            android:layout_marginEnd="12dp"
            android:contentDescription="Security Elevation" />

        <TextView
            android:id="@+id/tvElevationTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sign-Off Required"
            android:textColor="@color/text_oxide_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvElevationDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This action requires Project Manager capability credentials under jobsite compliance guidelines."
        android:textColor="@color/text_oxide_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRequestElevation"
        style="@style/IndustrialButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="REQUEST TEMPORARY SIGN-OFF"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnElevationDismiss"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="DISMISS"
        android:textColor="@color/text_oxide_secondary"
        android:textSize="13sp"
        style="@style/Widget.MaterialComponents.Button.TextButton" />

</LinearLayout>