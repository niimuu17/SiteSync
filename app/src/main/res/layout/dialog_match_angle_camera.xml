<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_ash_base">

    <!-- Top Header -->
    <RelativeLayout
        android:id="@+id/layoutCameraHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="@color/warm_ash_surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnCloseCamera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_inactive"
            android:contentDescription="Close"
            android:src="@drawable/ic_cancel_circle"
            app:tint="@color/text_oxide_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Match Angle"
                android:textColor="@color/text_oxide_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Align camera with milestone baseline"
                android:textColor="@color/text_oxide_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Camera Viewfinder & Ghost Overlay Container -->
    <FrameLayout
        android:id="@+id/layoutViewfinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutCameraControls"
        android:layout_below="@id/layoutCameraHeader">

        <!-- Live Camera View -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />

        <!-- Ghost Baseline Overlay ImageView (Alpha 0.40) -->
        <ImageView
            android:id="@+id/ivGhostOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.40"
            android:scaleType="centerCrop" />

        <!-- Alignment Reticle -->
        <View
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_reticle_frame" />
    </FrameLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/layoutCameraControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/warm_ash_surface"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Opacity Slider Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvOpacityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="Overlay Opacity: 40%"
                android:textColor="@color/text_oxide_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Ghost Baseline"
                android:textColor="@color/oxide_blue_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:value="40.0"
            android:valueFrom="0.0"
            android:valueTo="100.0"
            app:thumbColor="@color/oxide_blue_primary"
            app:trackColorActive="@color/oxide_blue_primary"
            app:trackColorInactive="@color/gauge_track_ash" />

        <!-- Shutter Button Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCaptureShutter"
                style="@style/IndustrialButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_centerInParent="true"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="Capture Verified Photo"
                app:icon="@drawable/ic_camera"
                app:iconTint="@color/text_on_oxide_white" />
        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>