<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_outlined"
    android:padding="24dp">

    <!-- Header Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pill_inactive"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UPDATE PROGRESS TELEMETRY"
        android:textColor="@color/text_oxide_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/tvSheetActivityTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Structural Column Pour L-14"
        android:textColor="@color/text_oxide_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <!-- Current vs New Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Completion Percentage"
            android:textColor="@color/text_oxide_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvProgressPercentValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="68%"
            android:textColor="@color/oxide_blue_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.0"
        android:valueTo="100.0"
        android:stepSize="1.0"
        android:value="68.0"
        app:thumbColor="@color/oxide_blue_primary"
        app:trackColorActive="@color/oxide_blue_primary"
        app:trackColorInactive="@color/gauge_track_ash"
        android:layout_marginBottom="16dp" />

    <!-- Status Picker Chips -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Work Status"
        android:textColor="@color/text_oxide_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusInProgress"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="IN PROGRESS"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@color/oxide_blue_primary"
            android:textColor="@color/text_on_oxide_white"
            app:cornerRadius="10dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusDelayed"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="DELAYED"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@color/warm_ash_surface"
            app:strokeColor="@color/oxide_blue_primary"
            app:strokeWidth="1.5dp"
            android:textColor="@color/text_oxide_primary"
            app:cornerRadius="10dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusCompleted"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="COMPLETED"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@color/warm_ash_surface"
            app:strokeColor="@color/oxide_blue_primary"
            app:strokeWidth="1.5dp"
            android:textColor="@color/text_oxide_primary"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- Remarks Field with Voice Dictation Button -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Field Observation Notes"
        android:textColor="@color/text_oxide_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <EditText
            android:id="@+id/etProgressNotes"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="top|start"
            android:padding="12dp"
            android:paddingEnd="48dp"
            android:background="@drawable/bg_pill_inactive"
            android:textColor="@color/text_oxide_primary"
            android:textColorHint="@color/text_oxide_muted"
            android:textSize="13sp"
            android:hint="Log site notes or tap microphone to speak..." />

        <ImageButton
            android:id="@+id/btnVoiceProgressNotes"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/etProgressNotes"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_mic_dictate"
            android:src="@drawable/ic_mic"
            app:tint="@color/oxide_blue_primary"
            android:contentDescription="Speak Note" />
    </RelativeLayout>

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveProgress"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="SYNC &amp; SAVE TELEMETRY"
        android:textColor="@color/text_on_oxide_white"
        android:textStyle="bold"
        android:textSize="14sp"
        app:backgroundTint="@color/oxide_blue_primary"
        app:cornerRadius="12dp" />

</LinearLayout>