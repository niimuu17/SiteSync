<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_outlined"
    android:backgroundTint="#FFFDF8F6"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_warning_hazard"
            app:tint="@color/status_red"
            android:background="@drawable/bg_badge_urgent"
            android:contentDescription="Emergency Hazard Alert" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FALL / IMPACT DETECTED"
                android:textColor="@color/status_red"
                android:textStyle="bold"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvFallTelemetrySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Extreme G-force impact and immobility registered"
                android:textColor="@color/text_oxide_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/stroke_card_border" />

    <!-- Countdown Timer Block -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency Response Dispatch In:"
            android:textColor="@color/text_oxide_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvCountdownSeconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15s"
            android:textColor="@color/status_red"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_marginVertical="8dp" />

        <TextView
            android:id="@+id/tvImpactMagnitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Peak Vector: 3.2G | Elevation: Level 3"
            android:textColor="@color/text_oxide_primary"
            android:fontFamily="monospace"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/stroke_card_border" />

    <!-- Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelFallAlert"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="I AM OK — CANCEL ALERT"
        android:textColor="@color/text_on_oxide_white"
        android:textStyle="bold"
        android:textSize="14sp"
        app:icon="@drawable/ic_check_circle"
        app:iconTint="@color/text_on_oxide_white"
        app:iconGravity="textStart"
        app:backgroundTint="@color/oxide_blue_primary"
        app:cornerRadius="26dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInstantEvacuate"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="DISPATCH RESCUE TEAM NOW"
        android:textColor="@color/status_red"
        android:textSize="13sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_warning_hazard"
        app:iconTint="@color/status_red"
        app:iconGravity="textStart"
        app:strokeColor="@color/status_red"
        app:strokeWidth="1.5dp"
        app:cornerRadius="24dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

</LinearLayout>
