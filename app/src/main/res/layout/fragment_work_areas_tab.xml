<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_ash_base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="100dp">

        <!-- 2x2 Telemetry Grid Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DISCIPLINE TELEMETRY"
                android:textColor="@color/text_oxide_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvLiveSyncBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE TELEMETRY"
                android:textColor="@color/text_oxide_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_inactive"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />
        </LinearLayout>

        <!-- 2x2 Grid (Outlined Warm Ash Cards, 1.5dp Oxide Blue Stroke, 20dp Radius) -->
        <!-- Row 1: Foundation & Structural Work -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Card 1: Foundation -->
            <LinearLayout
                android:id="@+id/cardFoundation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_outlined"
                android:padding="14dp"
                android:layout_marginEnd="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Foundation"
                        android:textColor="@color/text_oxide_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_arrow_diagonal"
                        app:tint="@color/oxide_blue_primary"
                        android:contentDescription="Expand" />
                </LinearLayout>

                <com.example.sitesync.ui.custom.SemiCircleGaugeView
                    android:id="@+id/gaugeFoundation"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="6dp"
                    app:gaugeProgress="85"
                    app:trendValue="+2.23 ▲"
                    app:gaugeSweepColor="@color/oxide_blue_primary"
                    app:gaugeTrackColor="@color/gauge_track_ash" />
            </LinearLayout>

            <!-- Card 2: Structural Work -->
            <LinearLayout
                android:id="@+id/cardStructural"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_outlined"
                android:padding="14dp"
                android:layout_marginStart="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Structural Work"
                        android:textColor="@color/text_oxide_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_arrow_diagonal"
                        app:tint="@color/oxide_blue_primary"
                        android:contentDescription="Expand" />
                </LinearLayout>

                <com.example.sitesync.ui.custom.SemiCircleGaugeView
                    android:id="@+id/gaugeStructural"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="6dp"
                    app:gaugeProgress="62"
                    app:trendValue="+1.23 ▲"
                    app:gaugeSweepColor="@color/oxide_blue_primary"
                    app:gaugeTrackColor="@color/gauge_track_ash" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Electrical & Finishing -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Card 3: Electrical -->
            <LinearLayout
                android:id="@+id/cardElectrical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_outlined"
                android:padding="14dp"
                android:layout_marginEnd="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Electrical"
                        android:textColor="@color/text_oxide_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_arrow_diagonal"
                        app:tint="@color/oxide_blue_primary"
                        android:contentDescription="Expand" />
                </LinearLayout>

                <com.example.sitesync.ui.custom.SemiCircleGaugeView
                    android:id="@+id/gaugeElectrical"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="6dp"
                    app:gaugeProgress="40"
                    app:trendValue="+.23 ▲"
                    app:gaugeSweepColor="@color/oxide_blue_primary"
                    app:gaugeTrackColor="@color/gauge_track_ash" />
            </LinearLayout>

            <!-- Card 4: Finishing -->
            <LinearLayout
                android:id="@+id/cardFinishing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_outlined"
                android:padding="14dp"
                android:layout_marginStart="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Finishing"
                        android:textColor="@color/text_oxide_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_arrow_diagonal"
                        app:tint="@color/oxide_blue_primary"
                        android:contentDescription="Expand" />
                </LinearLayout>

                <com.example.sitesync.ui.custom.SemiCircleGaugeView
                    android:id="@+id/gaugeFinishing"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="6dp"
                    app:gaugeProgress="18"
                    app:trendValue="-1.00 ▼"
                    app:gaugeSweepColor="@color/oxide_blue_primary"
                    app:gaugeTrackColor="@color/gauge_track_ash" />
            </LinearLayout>
        </LinearLayout>

        <!-- Solid Oxide Blue Presence & Safety Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_oxide_banner_card"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- White Pulsing Status Dot -->
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/indicator_pulse_dot"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvActiveWorkersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42 Active Workers on Site"
                    android:textColor="@color/text_on_oxide_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OSHA 100% Compliant • Zero Hazard Incidents"
                    android:textColor="@color/text_on_oxide_ash"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- White Rounded Pill with Navy Bold Text SHIFT 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHIFT 1"
                android:textColor="@color/oxide_blue_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_white_pill_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Field Hardware Toolkit Launchpad -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FIELD HARDWARE TOOLKIT"
            android:textColor="@color/text_oxide_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickCheckLevel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="CHECK LEVEL"
                android:textSize="11sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_grid"
                app:iconSize="16dp"
                app:iconTint="@color/oxide_blue_primary"
                app:backgroundTint="@color/warm_ash_surface"
                app:strokeColor="@color/stroke_oxide_blue"
                app:strokeWidth="1.5dp"
                android:textColor="@color/text_oxide_primary"
                app:cornerRadius="12dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickScanTicket"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="SCAN TICKET"
                android:textSize="11sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_camera"
                app:iconSize="16dp"
                app:iconTint="@color/oxide_blue_primary"
                app:backgroundTint="@color/warm_ash_surface"
                app:strokeColor="@color/stroke_oxide_blue"
                app:strokeWidth="1.5dp"
                android:textColor="@color/text_oxide_primary"
                app:cornerRadius="12dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
