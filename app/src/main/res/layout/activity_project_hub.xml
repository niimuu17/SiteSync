<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_canvas_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp">

            <!-- Top Header Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentStart="true">

                    <!-- App Brand Symbol Squircle -->
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_squircle_brand"
                        android:src="@drawable/ic_app_brand_symbol"
                        android:padding="8dp"
                        android:contentDescription="SiteSync Brand" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SiteSync"
                            android:textColor="@color/forest_dark"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHubUserGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Project Management Hub"
                            android:textColor="@color/forest_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Profile / Sign Out Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHubSignOut"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Sign Out"
                    android:textColor="@color/status_red"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_close"
                    app:iconTint="@color/status_red"
                    app:iconSize="14dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="8dp" />
            </RelativeLayout>

            <!-- Welcome / Overview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/forest_card_dark"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/forest_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CIVIL CONSTRUCTION HUB"
                        android:textColor="@color/peach_accent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvHubWelcomeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select Active Site Project"
                        android:textColor="@color/text_on_dark_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Open recently tracked telemetry ledgers, review progress against building plans, or initialize a new project scope."
                        android:textColor="@color/text_on_dark_muted"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Primary Action: Create New Project Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateNewProjectHub"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Create New Project"
                        android:textColor="@color/forest_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_add"
                        app:iconTint="@color/forest_dark"
                        app:iconGravity="textStart"
                        app:backgroundTint="@color/peach_accent"
                        app:cornerRadius="26dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recently Opened Projects Section Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvRecentProjectsHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recently Opened Projects"
                    android:textColor="@color/forest_dark"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true" />

                <!-- Show All / Collapse Toggle Pill -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleShowAllProjects"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Show All"
                    android:textColor="@color/forest_dark"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_more_horiz"
                    app:iconTint="@color/forest_dark"
                    app:iconSize="14dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp" />
            </RelativeLayout>

            <!-- RecyclerView for Recent Projects -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentProjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="5"
                tools:listitem="@layout/item_project_hub_card" />

            <!-- Empty State Layout -->
            <LinearLayout
                android:id="@+id/layoutEmptyProjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:paddingVertical="40dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_construction"
                    app:tint="@color/forest_muted"
                    android:contentDescription="Empty projects" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Projects Initialized"
                    android:textColor="@color/forest_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap 'Create New Project' above to define a building scope."
                    android:textColor="@color/forest_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
