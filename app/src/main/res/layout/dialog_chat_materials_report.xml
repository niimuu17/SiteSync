<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_forest"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_badge_pill_teal" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crew Material Requests"
                    android:textColor="@color/canvas_cream"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMaterialsCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    tools:text="3 DETECTED"
                    android:textColor="@color/forest_surface_deep"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_peach_solid"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvModelEngineBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="AI Extracted from crew chat • Multimodal LLM"
                android:textColor="@color/text_on_dark_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseMaterialsDialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/text_on_dark_secondary"
            android:contentDescription="Close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/forest_stroke"
        android:layout_marginBottom="12dp" />

    <!-- Select All / Toggle Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/btnToggleSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select All / Deselect All"
            android:textColor="@color/peach_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingVertical="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvSelectedSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="3 of 3 Selected"
            android:textColor="@color/text_on_dark_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- RecyclerView of Extracted Materials -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExtractedMaterials"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp"
        android:nestedScrollingEnabled="true"
        tools:listitem="@layout/item_chat_extracted_material" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmptyMaterials"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_checklist"
            app:tint="@color/forest_stroke"
            android:contentDescription="No materials" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No Material Requests in Recent Chat"
            android:textColor="@color/canvas_cream"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="When workers mention needed supplies in the chat, they will be listed here automatically."
            android:textColor="@color/text_on_dark_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCommitToRequiredList"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Add Selected to Required Items"
            android:textColor="@color/forest_surface_deep"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            app:backgroundTint="@color/peach_accent"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/forest_surface_deep"
            app:iconSize="18dp"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoToBriefings"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="Next: View Site Alerts &amp; Briefing ->"
            android:textColor="@color/peach_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="22dp"
            app:strokeColor="@color/forest_stroke"
            app:strokeWidth="1dp"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
