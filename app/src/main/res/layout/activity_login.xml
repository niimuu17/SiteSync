<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_ash_base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Geometric structural logo mark -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_squircle_amber"
            android:backgroundTint="@color/warm_ash_surface"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/imgBrandLogo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_app_brand_symbol"
                app:tint="@color/oxide_blue_primary"
                android:contentDescription="SiteSync Logo" />
        </FrameLayout>

        <!-- Header: Centered bold text -->
        <TextView
            android:id="@+id/tvLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to SiteSync"
            android:textColor="@color/text_oxide_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvLoginSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sign in using your Username or Gmail address"
            android:textColor="@color/text_oxide_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Error Message Banner -->
        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_input"
            android:backgroundTint="#FEE2E2"
            android:padding="12dp"
            android:textColor="@color/status_red"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            tools:visibility="visible"
            tools:text="Invalid credentials. Please try again." />

        <!-- Field 1: Username or Gmail -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Username or Gmail"
            android:textColor="@color/text_oxide_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_rounded_input"
            android:layout_marginBottom="18dp">

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Username or Gmail"
                android:textColor="@color/text_oxide_primary"
                android:textColorHint="@color/text_oxide_muted"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textEmailAddress"
                android:maxLines="1" />
        </FrameLayout>

        <!-- Field 2: Password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textColor="@color/text_oxide_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_rounded_input"
            android:layout_marginBottom="18dp">

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/ivTogglePassword"
                android:background="@android:color/transparent"
                android:hint="Enter your password"
                android:textColor="@color/text_oxide_primary"
                android:textColorHint="@color/text_oxide_muted"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:inputType="textPassword"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/ivTogglePassword"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="14dp"
                android:src="@drawable/ic_visibility_eye"
                app:tint="@color/oxide_blue_primary"
                android:contentDescription="Toggle Password Visibility" />
        </RelativeLayout>

        <!-- Two-Step Verification Badge -->
        <TextView
            android:id="@+id/tvTwoStepBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Two-Step Verification Enforced"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="6dp"
            android:drawableTint="@color/text_oxide_secondary"
            android:textColor="@color/text_oxide_secondary"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <!-- Primary Action Button: Log In -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogIn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/btn_primary_oxide"
                app:backgroundTint="@color/oxide_blue_primary"
                android:text="Log In"
                android:textColor="@color/text_on_oxide_white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/text_on_oxide_white"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Quick Demo Account Fill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvDemoFill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Demo fill: "
                android:textColor="@color/text_oxide_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnFillDemo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="elena@sitesync.com"
                android:textColor="@color/oxide_blue_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Footer: Don't have an account? Sign Up -->
        <TextView
            android:id="@+id/tvFooterSignUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don't have an account? Sign Up"
            android:textColor="@color/text_oxide_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>
