<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="14dp"
    android:background="@drawable/bg_table_row_selector">

    <!-- Avatar with Online Status Indicator -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/tvPersonAvatarInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_squircle_brand"
            android:gravity="center"
            android:text="MR"
            android:textColor="@color/forest_surface_deep"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/dotOnlineStatus"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/indicator_pulse_dot" />
    </FrameLayout>

    <!-- Info Column: Name, Role Badge, Phone -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPersonName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Md. Rafiqul Islam"
                android:textColor="@color/forest_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvPersonRoleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="SITE WORKER"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_low"
                android:textColor="#1E293B"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPersonSubtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+880 1712-345678 • Lead Rod Binder"
            android:textColor="@color/forest_muted"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Kick Out / Remove Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKickOutWorker"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="Kick Out"
        android:textColor="#DC2626"
        android:textSize="11sp"
        android:textStyle="bold"
        app:strokeColor="#FCA5A5"
        app:strokeWidth="1dp"
        app:cornerRadius="17dp"
        android:paddingHorizontal="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

    <!-- Manager/Lead Non-removable Badge -->
    <TextView
        android:id="@+id/tvAdminBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lead"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/peach_accent"
        android:background="@drawable/bg_pill_forest"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:visibility="gone" />

</LinearLayout>
