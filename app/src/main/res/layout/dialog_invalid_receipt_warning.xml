<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/forest_card_dark"
    app:strokeColor="@color/forest_stroke"
    app:strokeWidth="1dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Header: Alert Badge + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_badge_coral"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_warning_hazard"
                    app:tint="@color/alert_coral_text"
                    android:contentDescription="Alert Icon" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not a Delivery Challan / Receipt"
                    android:textColor="@color/text_on_dark_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Document Validation Failed"
                    android:textColor="@color/peach_accent"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Reason / Explanation Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/forest_surface_deep"
            android:padding="14dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/tvWarningReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The scanned image could not be verified as a construction delivery challan, cash memo, or materials receipt."
                android:textColor="@color/text_on_dark_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/forest_stroke_subtle"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scanner Checklist:"
                android:textColor="@color/peach_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Lay the challan, invoice, or memo flat under clear lighting.\n• Ensure supplier name, material items, and quantities are in focus.\n• Avoid glare, blurred photos, and extreme perspective angles."
                android:textColor="@color/text_on_dark_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="2.5dp" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDismissWarning"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Dismiss"
                android:textColor="@color/text_on_dark_secondary"
                android:textSize="13sp"
                app:strokeColor="@color/forest_stroke"
                app:strokeWidth="1dp"
                app:cornerRadius="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTryAgainScan"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:text="Try Again"
                android:textColor="@color/forest_surface_deep"
                android:textSize="13sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_camera"
                app:iconTint="@color/forest_surface_deep"
                app:iconGravity="textStart"
                app:backgroundTint="@color/peach_accent"
                app:cornerRadius="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>