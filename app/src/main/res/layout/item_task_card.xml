<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_outlined"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Card Header: Category Icon, Title & Priority Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <FrameLayout
            android:id="@+id/layoutTaskCategoryIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_squircle_brand"
            android:layout_marginEnd="10dp">

            <ImageView
                android:id="@+id/ivTaskCategoryIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_construction"
                app:tint="@color/forest_surface_deep"
                android:contentDescription="Task Category" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rebar Clearance Inspection - Grid 4B"
                android:textColor="@color/text_oxide_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPriorityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="URGENT"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_urgent"
            android:textColor="#991B1B"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Description Snippet -->
    <TextView
        android:id="@+id/tvTaskDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Check bottom steel cover before slab pour."
        android:textColor="@color/text_oxide_secondary"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="10dp" />

    <!-- Metadata Row: Assignee & Due Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- Assignee -->
        <TextView
            android:id="@+id/tvAssignee"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Elena Rostova (Lead Eng)"
            android:drawableStart="@drawable/ic_person"
            android:drawablePadding="4dp"
            android:drawableTint="@color/text_oxide_primary"
            android:gravity="center_vertical"
            android:textColor="@color/text_oxide_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Due Date Tag -->
        <TextView
            android:id="@+id/tvDueDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nov 12 (3d left)"
            android:drawableStart="@drawable/ic_calendar_toggle"
            android:drawablePadding="4dp"
            android:drawableTint="@color/text_oxide_secondary"
            android:gravity="center_vertical"
            android:textColor="@color/text_oxide_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Card Footer Actions: Status Dropdown & Notes Trigger -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Status Spinner -->
        <Spinner
            android:id="@+id/spinnerStatus"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_dropdown_small"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <!-- View Notes / Drill-down Button -->
        <LinearLayout
            android:id="@+id/btnViewNotes"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_secondary_outline"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Notes"
                android:textColor="@color/oxide_blue_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_arrow_diagonal"
                app:tint="@color/oxide_blue_primary"
                android:contentDescription="Expand" />
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>