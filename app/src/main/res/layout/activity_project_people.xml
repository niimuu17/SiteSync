<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas_cream">

    <!-- Top App Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/forest_dark"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBackPeople"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_on_dark_primary"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/btnBackPeople"
            android:layout_toStartOf="@+id/btnAddMember"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Project People"
                android:textColor="@color/text_on_dark_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPeopleProjectSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Metro Central Tower • MCT-2026"
                android:textColor="@color/peach_accent"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddMember"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="+ Add Worker"
            android:textColor="@color/forest_dark"
            android:textSize="11sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/forest_dark"
            app:iconSize="14dp"
            app:backgroundTint="@color/peach_accent"
            app:cornerRadius="18dp" />
    </RelativeLayout>

    <!-- Metrics Stat Ribbon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp">

        <!-- Stat 1: Total Personnel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_outlined"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL INVOLVED"
                android:textColor="@color/forest_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMetricTotalPeople"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 Members"
                android:textColor="@color/forest_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Stat 2: Active Site Workers -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_outlined"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginHorizontal="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SITE WORKERS"
                android:textColor="@color/forest_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMetricWorkersCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 Workers"
                android:textColor="@color/forest_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Stat 3: Site Leadership -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_outlined"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MANAGEMENT"
                android:textColor="@color/forest_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMetricLeadsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 Leads"
                android:textColor="@color/forest_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Attendance Table Quick Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewAttendanceTable"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="View Employee Attendance Table"
            android:textColor="@color/text_on_dark_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_table"
            app:iconTint="@color/peach_accent"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:backgroundTint="@color/forest_dark"
            app:cornerRadius="12dp"
            app:strokeColor="@color/forest_stroke"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Compact Messenger-style Table Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Subheader Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@color/forest_dark"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/tvManagerNotice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Manager Privilege"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/tvManagerNotice"
                    android:layout_marginEnd="8dp"
                    android:text="Assigned Project Crew Directory"
                    android:textColor="@color/peach_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:singleLine="true" />
            </RelativeLayout>

            <!-- People List Recycler -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProjectPeople"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmptyPeople"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_people"
                    app:tint="@color/forest_muted"
                    android:contentDescription="Empty" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Workers Assigned Yet"
                    android:textColor="@color/forest_dark"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share the project code with workers or tap '+ Add Worker' above."
                    android:textColor="@color/forest_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
