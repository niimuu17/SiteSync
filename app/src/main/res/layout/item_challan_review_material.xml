<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/forest_card_dark"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/forest_stroke"
    app:strokeWidth="1dp"
    app:rippleColor="@color/peach_alpha">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Product Icon + Material Name & Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Product Image Squircle Thumbnail -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/forest_surface_deep"
                app:strokeColor="@color/forest_stroke"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivReviewProductIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Product Image" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvMaterialName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BSRM 500W 16mm Rebar"
                android:textColor="@color/text_on_dark_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEEL"
                android:textColor="@color/text_on_dark_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_forest"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/btnRemoveItem"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_on_dark_muted"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Remove item" />
        </LinearLayout>

        <!-- Quantity & Billed Unit Price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quantity"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvQuantityAndUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5.0 TON"
                    android:textColor="@color/text_on_dark_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Billed Rate"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvBilledRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$ 92,000 / TON"
                    android:textColor="@color/peach_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Item Total"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvItemSubtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$ 460,000"
                    android:textColor="@color/text_on_dark_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/forest_stroke_subtle"
            android:layout_marginVertical="10dp" />

        <!-- Market Intelligence Benchmark & Variance Badge -->
        <LinearLayout
            android:id="@+id/layoutMarketIntelligence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvMarketBenchmark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Market Benchmark: $ 92,000"
                android:textColor="@color/text_on_dark_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvVarianceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fair Market Price"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_badge_green"
                android:textColor="@color/badge_green_text" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
