<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/scannerPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <!-- Top Header Overlay -->
    <RelativeLayout
        android:id="@+id/layoutScannerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#B316394F"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnCloseScanner"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_inactive"
            android:contentDescription="Close"
            android:src="@drawable/ic_cancel_circle"
            app:tint="@color/text_on_oxide_white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan QR, Barcode or Chalan"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScannerStatusSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Position tool tag, pallet QR, or chalan in frame"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Flash / Torch Toggle -->
        <ImageButton
            android:id="@+id/btnToggleFlash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_inactive"
            android:contentDescription="Toggle Flashlight"
            android:src="@drawable/ic_flash_on"
            app:tint="@color/text_on_oxide_white" />
    </RelativeLayout>

    <!-- Scanner Reticle Box (Transparent center with Oxide Blue border) -->
    <FrameLayout
        android:id="@+id/reticleFrame"
        android:layout_width="320dp"
        android:layout_height="240dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_reticle_frame">

        <!-- Laser Guide / Scanline -->
        <View
            android:id="@+id/viewScanline"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_gravity="center"
            android:background="@color/brand_amber" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:text="Align Chalan / Receipt Here"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#8016394F"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </FrameLayout>

    <!-- Live OCR Detection Preview Pill (shows user what text is being read in real time) -->
    <LinearLayout
        android:id="@+id/layoutOcrLiveFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/layoutBottomControls"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_card_outlined"
        android:backgroundTint="#E6EDE7DF"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ProgressBar
            android:id="@+id/pbOcrScanning"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminate="true"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvOcrLiveText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Point camera at receipt or tap Snap below"
            android:textColor="@color/text_oxide_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Bottom Controls Panel -->
    <LinearLayout
        android:id="@+id/layoutBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#CC16394F"
        android:padding="16dp">

        <!-- Shutter Button: Snap & Parse Chalan -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSnapChalan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_pill_primary"
            app:backgroundTint="@color/brand_amber"
            android:text="📸  Snap &amp; Parse Chalan"
            android:textColor="#16394F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Row: Pick from Gallery & Manual Fallback -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickFromGallery"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/btn_secondary_outline"
                app:backgroundTint="#33EDE7DF"
                app:strokeColor="#EDE7DF"
                app:strokeWidth="1dp"
                android:text="🖼️ Gallery"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualEntry"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/btn_secondary_outline"
                app:backgroundTint="#33EDE7DF"
                app:strokeColor="#EDE7DF"
                app:strokeWidth="1dp"
                android:text="✍️ Manual"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
