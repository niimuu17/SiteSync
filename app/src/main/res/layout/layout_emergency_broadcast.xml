<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutEmergencyContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_emergency"
    android:padding="20dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_badge_urgent"
            android:backgroundTint="#FEE2E2"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_warning_amber"
                app:tint="#EF4444"
                android:contentDescription="Emergency Beacon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMERGENCY SITE BROADCAST"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perimeter evacuation &amp; hazard warning subsystem"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Active Emergency Broadcast Notice Banner (Shown when an emergency is live) -->
    <LinearLayout
        android:id="@+id/bannerActiveEmergency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_badge_urgent"
        android:padding="10dp"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/indicator_pulse_dot"
            app:backgroundTint="#EF4444"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvActiveEmergencyInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ACTIVE BROADCAST: Structural Failure Threat"
            android:textColor="#991B1B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCancelEmergency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CANCEL"
            android:textColor="#EF4444"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="4dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTriggerEmergency"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_btn_emergency"
        app:backgroundTint="@null"
        android:text="🚨  TRIGGER EMERGENCY ALERT"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:elevation="4dp" />

</LinearLayout>
