<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="100dp">

        <!-- 5-Section Daily Report Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DAILY SITE REPORT (5-SECTION)"
                android:textColor="@color/accent_safety_amber"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvReportDateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 FEB 2026"
                android:textColor="@color/accent_safety_amber"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_inactive"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <!-- Form Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dark_card"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <!-- Section 1: Weather & Site Conditions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Weather &amp; Ambient Conditions"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etDailyWeather"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill_inactive"
                android:padding="10dp"
                android:text="Clear Sky • 24°C • Wind: 8 km/h NW • Humidity: 45%"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- Section 2: Completed Work with "Speak Note" Voice Integration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2. Completed Work &amp; Structural Notes"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnVoiceDictateWork"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_mic_dictate"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/accent_safety_amber"
                    android:contentDescription="Speak Note" />
            </LinearLayout>

            <EditText
                android:id="@+id/etDailyCompletedWork"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="top|start"
                android:background="@drawable/bg_pill_inactive"
                android:padding="10dp"
                android:text="Completed rebar cage installation on Level 14 columns 1 through 8. Ready for concrete slump test."
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- Section 3: Manpower & Headcount -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Deployed Trades &amp; Manpower"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etDailyManpower"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill_inactive"
                android:padding="10dp"
                android:text="42 Field Workers: 16 Steel Fixers, 14 Carpenters, 8 Electricians, 4 Riggers"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- Section 4: Materials Used & "Scan Delivery Ticket" ML Kit Integration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="4. Materials Consumed"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanTicketMaterials"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="SCAN TICKET"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_camera"
                    app:iconSize="14dp"
                    app:backgroundTint="@color/dark_surface_elevated"
                    app:strokeColor="@color/accent_safety_amber"
                    app:strokeWidth="1dp"
                    android:textColor="@color/accent_safety_amber"
                    app:cornerRadius="6dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etDailyMaterials"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="top|start"
                android:background="@drawable/bg_pill_inactive"
                android:padding="10dp"
                android:text="C35 Ready-Mix Concrete: 85 cu yd (Ticket #40289), Rebar #6 Grade 60: 4.2 Tons"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- Section 5: Equipment & Site Problems -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. Equipment &amp; Incident Logs"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etDailyEquipment"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill_inactive"
                android:padding="10dp"
                android:text="Tower Crane #2 operational (8 hrs). 1 Scissor lift hydraulic line inspected."
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginBottom="18dp" />

            <!-- Form Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveDraftReport"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="SAVE DRAFT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/dark_surface_elevated"
                    app:strokeColor="@color/dark_border"
                    app:strokeWidth="1dp"
                    android:textColor="@color/text_primary"
                    app:cornerRadius="8dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitReportPdf"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="SUBMIT &amp; SHARE PDF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_safety_amber"
                    android:textColor="@color/dark_canvas"
                    app:cornerRadius="8dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Technical Issues & Live RFI Stream Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TECHNICAL ISSUES &amp; RFI STREAM"
                android:textColor="@color/accent_safety_amber"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 ACTIVE RFIS"
                android:textColor="@color/accent_safety_amber"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_inactive"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <!-- RFI Card 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dark_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HVAC Duct Clash with Beam B-4"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HIGH PRIORITY"
                    android:textColor="@color/accent_terracotta"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_inactive"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Building 2 • Level 14 Core • Status: OPEN"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenRfiChat1"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="OPEN LIVE RFI CHAT STREAM"
                android:textSize="11sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_comment"
                app:iconSize="16dp"
                app:backgroundTint="@color/dark_surface_elevated"
                app:strokeColor="@color/accent_safety_amber"
                app:strokeWidth="1dp"
                android:textColor="@color/accent_safety_amber"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- RFI Card 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dark_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Curtain Wall Anchor Embed Depth"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MED PRIORITY"
                    android:textColor="@color/accent_safety_amber"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_inactive"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Building 2 • Level 12 West Facade • Status: IN REVIEW"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenRfiChat2"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="OPEN LIVE RFI CHAT STREAM"
                android:textSize="11sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_comment"
                app:iconSize="16dp"
                app:backgroundTint="@color/dark_surface_elevated"
                app:strokeColor="@color/accent_safety_amber"
                app:strokeWidth="1dp"
                android:textColor="@color/accent_safety_amber"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
