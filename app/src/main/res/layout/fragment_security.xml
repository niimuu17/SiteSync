<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_ash_base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="100dp">

        <!-- Top Section Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SITE SAFETY &amp; RELIABILITY PROTOCOLS"
            android:textColor="@color/text_oxide_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <!-- 1. Emergency Site Broadcast Card -->
        <include
            android:id="@+id/incEmergency"
            layout="@layout/layout_emergency_broadcast" />

        <!-- 1b. Acoustic Safety Decibel Meter Telemetry Card -->
        <LinearLayout
            android:id="@+id/cardAcousticSafety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_outlined"
            android:padding="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivNoiseIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/oxide_blue_primary"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACOUSTIC SAFETY TELEMETRY"
                        android:textColor="@color/text_oxide_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoiseStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="SAFE • 68 dB"
                    android:textColor="#065F46"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_optimal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvNoisePpeWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ambient jobsite noise is within normal limits. Hearing protection recommended above 85 dB."
                android:textColor="@color/text_oxide_secondary"
                android:textSize="11sp"
                android:layout_marginBottom="10dp" />

            <ProgressBar
                android:id="@+id/pbDecibelLevel"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="120"
                android:progress="68"
                android:progressTint="@color/status_green"
                android:progressBackgroundTint="@color/gauge_track_ash" />

        </LinearLayout>

        <!-- 2. Site Hazard & Safety Ticketing Feed Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HAZARD TICKETING FEED"
                    android:textColor="@color/text_oxide_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tvHazardCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 OPEN"
                    android:textColor="#991B1B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_urgent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Report Hazard Action Button -->
            <TextView
                android:id="@+id/btnReportHazardHeader"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:gravity="center"
                android:text="+ Report Hazard"
                android:textColor="@color/oxide_blue_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/btn_secondary_outline"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <!-- Hazard Filter Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/chipHazardsOpen"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="Active Hazards"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tab_pill_active"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipHazardsResolved"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="Resolved History"
                android:textColor="@color/text_oxide_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_inactive"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Hazard Tickets List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHazardTickets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layoutHazardEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_outlined"
            android:padding="28dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_cloud_done"
                app:tint="@color/status_green"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvEmptyStateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zero Active Hazards • Site Perimeter Safe"
                android:textColor="@color/text_oxide_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No open safety tickets on this active project floor."
                android:textColor="@color/text_oxide_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 3. Offline Cache & Cloud Sync Telemetry Card -->
        <include
            android:id="@+id/incSyncTelemetry"
            layout="@layout/layout_sync_telemetry" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
