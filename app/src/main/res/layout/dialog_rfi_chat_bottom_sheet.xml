<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="520dp"
    android:orientation="vertical"
    android:background="@drawable/bg_dark_card"
    android:padding="20dp">

    <!-- Header Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pill_inactive"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvRfiTicketId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RFI-2026-042"
            android:textColor="@color/accent_safety_amber"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvRfiStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OPEN"
            android:textColor="@color/dark_canvas"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_tab_pill_active"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRfiTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HVAC Ductwork Clash with Structural Beam B-4"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dark_border"
        android:layout_marginBottom="12dp" />

    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRfiChatThread"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Chat Input Row with Voice Dictation Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_inactive"
        android:padding="6dp"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Type reply or tap mic..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp" />

        <ImageButton
            android:id="@+id/btnVoiceChat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/btn_mic_dictate"
            android:src="@drawable/ic_mic"
            app:tint="@color/accent_safety_amber"
            android:contentDescription="Speak Note"
            android:layout_marginEnd="6dp" />

        <ImageButton
            android:id="@+id/btnSendChat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_tab_pill_active"
            android:src="@drawable/ic_send"
            app:tint="@color/dark_canvas"
            android:contentDescription="Send Reply" />
    </LinearLayout>

</LinearLayout>
