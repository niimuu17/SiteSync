<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_forest"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_pill_forest"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Record Material Consumption"
        android:textColor="@color/text_on_dark_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Site Construction &amp; Dispatch Ledger"
        android:textColor="@color/peach_accent"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <!-- Material Details Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/forest_card_dark"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/forest_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvOutMaterialName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BSRM 500W 16mm Rebar"
                android:textColor="@color/text_on_dark_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOutAvailableBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available: 23.0 TON"
                android:textColor="@color/text_on_dark_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quantity Input -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantity to Consume / Pour"
        app:boxStrokeColor="@color/peach_accent"
        app:hintTextColor="@color/peach_accent"
        android:textColorHint="@color/text_on_dark_muted"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etOutQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_dark_primary"
            android:textSize="15sp"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Location / Purpose Input -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Work Area / Purpose (e.g. 4th Floor Slab Pouring)"
        app:boxStrokeColor="@color/peach_accent"
        app:hintTextColor="@color/peach_accent"
        android:textColorHint="@color/text_on_dark_muted"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etOutPurpose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_dark_primary"
            android:textSize="14sp"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Authorized Receiver Input -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Authorized Foreman / Engineer"
        app:boxStrokeColor="@color/peach_accent"
        app:hintTextColor="@color/peach_accent"
        android:textColorHint="@color/text_on_dark_muted"
        android:layout_marginBottom="20dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etOutReceiver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_dark_primary"
            android:textSize="14sp"
            android:inputType="textCapWords" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirm Pill CTA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmStockOut"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Confirm Stock Out"
        android:textColor="@color/forest_surface_deep"
        android:textSize="15sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_check_circle"
        app:iconTint="@color/forest_surface_deep"
        app:iconGravity="textStart"
        app:backgroundTint="@color/peach_accent"
        app:cornerRadius="27dp"
        app:elevation="0dp"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelStockOut"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Cancel"
        android:textColor="@color/text_on_dark_muted"
        android:textSize="13sp"
        app:cornerRadius="22dp"
        android:textAllCaps="false" />

</LinearLayout>
