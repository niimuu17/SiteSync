<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@android:color/transparent"
    android:gravity="center">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/forest_card_dark"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/forest_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Profile Avatar Squircle with Add/Change Photo Button -->
            <FrameLayout
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginBottom="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileModalAvatar"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_squircle_brand"
                    android:src="@drawable/ic_person"
                    app:tint="@color/forest_surface_deep"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

                <!-- Add / Edit Photo Badge -->
                <FrameLayout
                    android:id="@+id/btnChangeProfilePhoto"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_pill_peach_solid"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/forest_surface_deep"
                        android:contentDescription="Change Photo" />
                </FrameLayout>
            </FrameLayout>

            <!-- User Full Name -->
            <TextView
                android:id="@+id/tvProfileModalName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marcus Vance"
                android:textColor="@color/text_on_dark_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Role Badge -->
            <TextView
                android:id="@+id/tvProfileModalRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill_teal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="PROJECT MANAGER"
                android:textColor="@color/peach_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <!-- Info Container Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_forest_input"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Email / ID:"
                        android:textColor="@color/text_on_dark_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvProfileModalEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="marcus@sitesync.com"
                        android:textColor="@color/text_on_dark_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Active Project:"
                        android:textColor="@color/text_on_dark_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvProfileModalProject"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRJ-DHAKA-101"
                        android:textColor="@color/peach_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Build Engine:"
                        android:textColor="@color/text_on_dark_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SiteSync Enterprise v8.0"
                        android:textColor="@color/text_on_dark_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Action Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfileSwitchHub"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Switch Project (Open Hub)"
                android:textColor="@color/forest_surface_deep"
                android:textSize="13sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_business"
                app:iconTint="@color/forest_surface_deep"
                app:iconGravity="textStart"
                app:backgroundTint="@color/peach_accent"
                app:cornerRadius="24dp"
                android:layout_marginBottom="10dp"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfileSignOut"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Sign Out"
                android:textColor="@color/alert_coral_text"
                android:textSize="13sp"
                app:strokeColor="@color/alert_coral_stroke"
                app:strokeWidth="1dp"
                app:cornerRadius="24dp"
                android:layout_marginBottom="8dp"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/btnProfileClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Close"
                android:textColor="@color/text_on_dark_secondary"
                android:textSize="13sp"
                android:padding="8dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
