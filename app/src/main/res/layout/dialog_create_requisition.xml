<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_outlined"
    android:backgroundTint="@color/warm_ash_base"
    android:padding="20dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pill_inactive"
        android:layout_marginBottom="16dp" />

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Material Requisition"
        android:textColor="@color/text_oxide_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Order bulk jobsite materials before thresholds are breached"
        android:textColor="@color/text_oxide_secondary"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <!-- Material Selector -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Material"
        android:textColor="@color/text_oxide_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerReqMaterial"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_rounded_input"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginBottom="12dp" />

    <!-- Quantity & Unit Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quantity Needed"
                android:textColor="@color/text_oxide_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etReqQuantity"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_rounded_input"
                android:inputType="numberDecimal"
                android:hint="e.g. 500"
                android:textColor="@color/text_oxide_primary"
                android:textColorHint="@color/text_oxide_muted"
                android:textSize="14sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unit"
                android:textColor="@color/text_oxide_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerReqUnit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_rounded_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Need-By Date -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Need-By Date"
        android:textColor="@color/text_oxide_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:id="@+id/layoutReqNeedByDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_rounded_input"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_calendar_toggle"
            app:tint="@color/oxide_blue_primary"
            android:contentDescription="Calendar" />

        <TextView
            android:id="@+id/tvReqNeedByDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Select delivery deadline..."
            android:textColor="@color/text_oxide_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Urgency Level Pills -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Urgency Level"
        android:textColor="@color/text_oxide_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/pillUrgencyStandard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Standard"
            android:textColor="@color/text_on_oxide_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_tab_pill_active"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/pillUrgencyHigh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="High Priority"
            android:textColor="@color/text_oxide_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_inactive"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/pillUrgencyEmergency"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Emergency"
            android:textColor="@color/text_oxide_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_inactive"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Justification Notes -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Justification / Field Notes"
        android:textColor="@color/text_oxide_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etReqJustification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="2"
        android:gravity="top|start"
        android:background="@drawable/bg_rounded_input"
        android:hint="e.g. Pour scheduled for Level 4 columns on Friday..."
        android:textColor="@color/text_oxide_primary"
        android:textColorHint="@color/text_oxide_muted"
        android:textSize="13sp"
        android:padding="12dp"
        android:layout_marginBottom="20dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelRequisition"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/btn_secondary_outline"
            app:backgroundTint="@color/warm_ash_surface"
            app:strokeColor="@color/stroke_oxide_blue"
            app:strokeWidth="1.5dp"
            android:text="Cancel"
            android:textColor="@color/oxide_blue_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitRequisition"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.6"
            android:background="@drawable/btn_primary_oxide"
            app:backgroundTint="@color/oxide_blue_primary"
            android:text="Submit Requisition"
            android:textColor="@color/text_on_oxide_white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>