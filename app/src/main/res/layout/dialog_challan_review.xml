<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_forest"
    android:padding="20dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_pill_forest"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Challan Verification"
                android:textColor="@color/text_on_dark_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiSourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini 1.5 Flash Vision AI"
                android:textColor="@color/peach_accent"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivChallanThumbnail"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_document"
            android:background="@color/forest_card_dark"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
            app:strokeColor="@color/forest_stroke"
            app:strokeWidth="1dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Challan image thumbnail" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="420dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Challan Metadata Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/forest_card_dark"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/forest_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DELIVERY DETAILS"
                        android:textColor="@color/text_on_dark_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="10dp" />

                    <!-- Supplier Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Supplier / Vendor"
                        app:boxStrokeColor="@color/peach_accent"
                        app:hintTextColor="@color/peach_accent"
                        android:textColorHint="@color/text_on_dark_muted"
                        android:layout_marginBottom="10dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSupplierName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_on_dark_primary"
                            android:textSize="14sp"
                            android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Challan No & Date In Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Challan #"
                            app:boxStrokeColor="@color/peach_accent"
                            app:hintTextColor="@color/peach_accent"
                            android:textColorHint="@color/text_on_dark_muted"
                            android:layout_marginEnd="6dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etChallanNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_on_dark_primary"
                                android:textSize="14sp"
                                android:inputType="textCapCharacters" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Date"
                            app:boxStrokeColor="@color/peach_accent"
                            app:hintTextColor="@color/peach_accent"
                            android:textColorHint="@color/text_on_dark_muted"
                            android:layout_marginStart="6dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etChallanDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_on_dark_primary"
                                android:textSize="14sp"
                                android:inputType="date" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Duplicate Receipt Warning Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDuplicateWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/alert_coral_bg"
                app:strokeColor="@color/alert_coral_stroke"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_warning_hazard"
                        app:tint="@color/alert_coral_text"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Duplicate Warning Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Duplicate Receipt Detected"
                            android:textColor="@color/alert_coral_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDuplicateDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="This receipt has already been added to inventory."
                            android:textColor="@color/alert_coral_text"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Detected Materials Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvMaterialsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Parsed Materials &amp; Rates"
                    android:textColor="@color/text_on_dark_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvItemsCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 Items"
                    android:textColor="@color/peach_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Items RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvReviewMaterials"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="12dp"
                tools:listitem="@layout/item_challan_review_material" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Total Amount & Summary Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_pill_forest"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total Billed Value"
            android:textColor="@color/text_on_dark_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTotalChallanAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$ 0.00"
            android:textColor="@color/peach_accent"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Actions -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddToInventory"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Add to Inventory"
        android:textColor="@color/forest_surface_deep"
        android:textSize="15sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/forest_surface_deep"
        app:iconGravity="textStart"
        app:backgroundTint="@color/peach_accent"
        app:cornerRadius="27dp"
        app:elevation="0dp"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelReview"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Cancel &amp; Discard"
        android:textColor="@color/text_on_dark_muted"
        android:textSize="13sp"
        app:cornerRadius="22dp"
        android:textAllCaps="false" />

</LinearLayout>
