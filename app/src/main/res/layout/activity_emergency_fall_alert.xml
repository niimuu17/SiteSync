<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="24dp">

    <View
        android:id="@+id/viewGlowBg"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_badge_urgent"
        android:alpha="0.25"
        app:layout_constraintTop_toTopOf="@id/ivEmergencyIcon"
        app:layout_constraintBottom_toBottomOf="@id/ivEmergencyIcon"
        app:layout_constraintStart_toStartOf="@id/ivEmergencyIcon"
        app:layout_constraintEnd_toEndOf="@id/ivEmergencyIcon" />

    <ImageView
        android:id="@+id/ivEmergencyIcon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="32dp"
        android:padding="20dp"
        android:background="@drawable/bg_badge_urgent"
        android:src="@drawable/ic_warning_hazard"
        app:tint="@color/status_red"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Fall Impact Emergency" />

    <TextView
        android:id="@+id/tvFallAlertTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="MAN-DOWN / FALL DETECTED"
        android:textColor="#EF4444"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        app:layout_constraintTop_toBottomOf="@id/ivEmergencyIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvFallAlertSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Extreme impact &amp; immobility detected in pocket mode"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvFallAlertTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Countdown Display Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCountdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#1E293B"
        app:strokeColor="#334155"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvFallAlertSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency Rescue Auto-Dispatch In:"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCountdownSeconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="15s"
                android:textColor="#EF4444"
                android:textSize="54sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvImpactMagnitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Peak Impact: 3.5G | Immobility Flagged"
                android:textColor="#F5C29B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- GPS Location Badge -->
            <LinearLayout
                android:id="@+id/layoutGpsStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge_optimal"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:id="@+id/ivGpsLockIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/status_green"
                    android:contentDescription="GPS Coordinate Telemetry" />

                <TextView
                    android:id="@+id/tvFallGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:text="Acquiring Real GPS Fix..."
                    android:textColor="@color/status_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Worker Meta Card -->
    <LinearLayout
        android:id="@+id/layoutWorkerMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1E293B"
        android:padding="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/cardCountdown"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvWorkerInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Worker: Minar Rahman • Metro Central Tower"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelFallAlert"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="I AM OK — CANCEL ALERT"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#223832"
        app:cornerRadius="12dp"
        app:strokeColor="#526B64"
        app:strokeWidth="1.5dp"
        app:layout_constraintBottom_toTopOf="@id/btnInstantEvacuate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInstantEvacuate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:text="DISPATCH RESCUE TEAM NOW"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#B9382C"
        app:cornerRadius="12dp"
        app:strokeColor="#EF4444"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
