<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Handle -->
        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_bottom_sheet_handle"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="REPORT JOBSITE HAZARD"
                android:textColor="@color/text_oxide_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <ImageView
                android:id="@+id/btnCloseDialog"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_oxide_secondary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Category Dropdown -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HAZARD CATEGORY"
            android:textColor="@color/text_oxide_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerHazardCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_dropdown_small"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Priority Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEVERITY / PRIORITY"
            android:textColor="@color/text_oxide_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/pillPriorityUrgent"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="URGENT"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_emergency"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/pillPriorityMedium"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="MEDIUM"
                android:textColor="@color/text_oxide_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_inactive"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/pillPriorityLow"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="LOW"
                android:textColor="@color/text_oxide_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_inactive"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Location Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SPECIFIC LOCATION / AREA"
            android:textColor="@color/text_oxide_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etHazardLocation"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="e.g. Level 2 - East Pump Room"
            android:background="@drawable/bg_rounded_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_oxide_primary"
            android:textColorHint="@color/text_oxide_muted"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- Description with Speech Button -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HAZARD DESCRIPTION"
            android:textColor="@color/text_oxide_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="6dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etHazardDescription"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:gravity="top|start"
                android:hint="Detail safety non-compliance, exposed hazard, or structural issue..."
                android:background="@drawable/bg_rounded_input"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="48dp"
                android:paddingBottom="12dp"
                android:textColor="@color/text_oxide_primary"
                android:textColorHint="@color/text_oxide_muted"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btnHazardVoiceDictate"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:padding="6dp"
                android:src="@drawable/ic_mic"
                app:tint="@color/oxide_blue_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Speak Note" />
        </RelativeLayout>

        <!-- Geotag Photo Status -->
        <LinearLayout
            android:id="@+id/btnCaptureHazardPhoto"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/btn_secondary_outline"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_camera"
                app:tint="@color/oxide_blue_primary"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvCapturePhotoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Geotagged Photo: 40.7128°N, 74.0060°W"
                android:textColor="@color/oxide_blue_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Submit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitHazard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_pill_primary"
            app:backgroundTint="@null"
            android:text="LOG HAZARD TICKET"
            android:textColor="@color/text_on_oxide_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
