<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/forest_card_dark"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/forest_stroke"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Badges Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvBriefingSeverityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="CRITICAL"
                android:textColor="@color/alert_coral_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_alert_coral"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

            <TextView
                android:id="@+id/tvBriefingCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                tools:text="SAFETY HAZARD"
                android:textColor="@color/peach_accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_pill_teal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvBriefingReporter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Reported by Alex Chen"
                android:textColor="@color/text_on_dark_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Title & Details -->
        <TextView
            android:id="@+id/tvBriefingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="Water Leaking in 3rd Floor Plumbing Shaft"
            android:textColor="@color/canvas_cream"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBriefingDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="Main supply pipe valve loose. Water dripping onto newly plastered walls in Unit 302."
            android:textColor="@color/text_on_dark_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <!-- Suggested Manager Action Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_forest_input"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:layout_marginTop="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_flash_on"
                app:tint="@color/peach_accent"
                android:contentDescription="Action" />

            <TextView
                android:id="@+id/tvSuggestedAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                tools:text="Suggested Action: Dispatch plumbing foreman to shut off main gate valve immediately."
                android:textColor="@color/peach_accent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
