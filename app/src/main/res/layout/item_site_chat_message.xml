<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutMessageContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp"
    android:paddingHorizontal="16dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMessageBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <!-- Sender & Role Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvChatSenderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Marcus Vance"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChatSenderRoleBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_pill_teal"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="MANAGER"
                    android:textColor="@color/peach_accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChatUrgentBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_alert_coral"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="URGENT"
                    android:textColor="@color/alert_coral_text"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Message Text -->
            <TextView
                android:id="@+id/tvChatMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please verify rebar tie spacing on the east column before 3 PM pouring."
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <!-- Photo Attachment -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivChatImageAttachment"
                android:layout_width="220dp"
                android:layout_height="140dp"
                android:layout_marginBottom="6dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"
                tools:visibility="visible" />

            <!-- Audio Note Player Container -->
            <LinearLayout
                android:id="@+id/layoutAudioAttachment"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill_forest_action"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/ivAudioPlayPause"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_flash_on"
                    app:tint="@color/peach_accent" />

                <TextView
                    android:id="@+id/tvAudioDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Voice Note • Play"
                    android:textColor="@color/peach_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Time Stamp -->
            <TextView
                android:id="@+id/tvChatMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="11:42 AM"
                android:textSize="10sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
