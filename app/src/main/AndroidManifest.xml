<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions for Firebase & real-time sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Hardware Subsystem Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.barometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <application
        android:name=".SiteSyncApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.SiteSync"
        tools:targetApi="31">

        <!-- Screen 1: LoginActivity (Primary App Launcher) -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: SignUpActivity -->
        <activity
            android:name=".ui.SignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 3: Main Dashboard (Default: Progress Tab) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Legacy WelcomeActivity -->
        <activity
            android:name=".ui.WelcomeActivity"
            android:exported="false" />

        <!-- RBAC Authentication Screen -->
        <activity
            android:name=".ui.AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Unified Site Command Cockpit (Single-Module Architecture) -->
        <activity
            android:name=".ui.cockpit.UnifiedSiteCockpitActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Role Dashboards -->
        <activity
            android:name=".ui.ManagerDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SupervisorDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.EngineerDashboardActivity"
            android:exported="true" />

        <!-- Engineer Module: Site Progress Monitoring Activities -->
        <activity
            android:name=".ui.ProgressMonitoringActivity"
            android:exported="true" />

        <activity
            android:name=".ui.ProgressDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.UpdateProgressActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.AddActivityActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Engineer Module: Site Inspection & Quality Control Activities -->
        <activity
            android:name=".ui.InspectionListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CreateInspectionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.InspectionDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ReInspectionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Engineer Module: Drawing & Document Management Activities -->
        <activity
            android:name=".ui.DocumentManagementActivity"
            android:exported="false" />

        <activity
            android:name=".ui.DocumentDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.UploadDocumentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.PdfViewerActivity"
            android:exported="false" />

        <!-- Engineer Module: Technical Issue / RFI Management Activities -->
        <activity
            android:name=".ui.IssueManagementActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CreateIssueActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.IssueDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Engineer Module: Daily Site Report Activities -->
        <activity
            android:name=".ui.DailyReportListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CreateDailyReportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.DailyReportDetailActivity"
            android:exported="false" />

        <!-- FileProvider for Sharing Generated PDF Reports -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Executive & Industrial Telemetry Screens (Reference UI Redesign) -->
        <activity
            android:name=".ui.ExecutiveProgressActivity"
            android:exported="true" />

        <activity
            android:name=".ui.BuildingPlanActivity"
            android:exported="true" />

        <activity
            android:name=".ui.WorkAreasActivity"
            android:exported="true" />

        <!-- Reorganized Enterprise Subpackage Activities -->
        <activity android:name=".ui.auth.AuthActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.dashboard.EngineerDashboardActivity" android:exported="false" />
        <activity android:name=".ui.dashboard.ManagerDashboardActivity" android:exported="false" />
        <activity android:name=".ui.dashboard.SupervisorDashboardActivity" android:exported="false" />
        <activity android:name=".ui.progress.ProgressMonitoringActivity" android:exported="false" />
        <activity android:name=".ui.progress.UpdateProgressActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.inspections.InspectionListActivity" android:exported="false" />
        <activity android:name=".ui.inspections.CreateInspectionActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.inspections.InspectionDetailActivity" android:exported="false" />
        <activity android:name=".ui.inspections.ReInspectionActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.documents.DocumentManagementActivity" android:exported="false" />
        <activity android:name=".ui.documents.PdfViewerActivity" android:exported="false" />
        <activity android:name=".ui.issues.IssueManagementActivity" android:exported="false" />
        <activity android:name=".ui.issues.IssueDetailActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.reports.DailyReportListActivity" android:exported="false" />
        <activity android:name=".ui.reports.CreateDailyReportActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.reports.DailyReportDetailActivity" android:exported="false" />

        <receiver
            android:name=".utils.TaskReminderReceiver"
            android:exported="false" />
    </application>

</manifest>
